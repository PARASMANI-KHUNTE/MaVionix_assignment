# ==============================================================================
# AI-Powered CRM - Environment Variables Example
# Copy this file to .env.local (root) and server/.env, client/.env respectively
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Neon Lakebase Postgres or Local Postgres)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# AI Intelligence Provider ('gemini', 'neon', or 'mock')
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# API Security & Authentication
API_KEYS=your-api-key-1,your-api-key-2
ALLOW_NO_AUTH=true

# Neon Cloud Platform Services (Configured automatically via `neon deploy`)
NEON_BRANCH=production
NEON_BRANCH_ID=br-sample-branch-id
NEON_FUNCTION_HOST_SUFFIX=.compute.region.aws.neon.tech
NEON_FUNCTION_URL=https://sample-function.compute.region.aws.neon.tech/
NEON_AUTH_BASE_URL=https://sample-auth.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://sample-auth.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_REALTIME_URL=wss://sample-realtime.rt.region.aws.neon.tech/
NEON_REALTIME_SECRET=nrt_live_sample_realtime_secret
AWS_ACCESS_KEY_ID=nak_live_sample_storage_key
AWS_SECRET_ACCESS_KEY=nsk_live_sample_storage_secret
AWS_ENDPOINT_URL_S3=https://sample-storage.storage.region.aws.neon.tech
AWS_REGION=ap-southeast-1
NEON_AI_GATEWAY_TOKEN=nt_live_sample_gateway_token
NEON_AI_GATEWAY_BASE_URL=https://sample-gateway.ai.region.aws.neon.tech

# Client Configuration
VITE_API_URL=http://localhost:5000/api/v1
VITE_API_KEY=your-api-key-here
